#!/bin/sh
# pre-commit：提交前跑启动脚本的维护规则检查。
#
# 为什么需要这个 hook：检查器存在 ≠ 检查被执行。这两条规则（.bat 必须 ASCII+CRLF、
# .ps1 必须 UTF-8 BOM）已经被破坏过两次，每次都导致"看起来成功、其实用空路径启动编辑器"
# 或"整段脚本解析失败"。放在 hook 里是当前成本最低的自动触发点（不需要 CI）。
#
# 启用方式（每个 clone 一次）：
#   git config core.hooksPath .githooks
#
# 跑的是同一个 tools/verify-launcher.ps1，和 README 里写的手动自检一致。

# 前提工具缺失时必须**拒绝提交**（fail-closed），不能静默放行：
# 实测过 PATH 里没有 grep 时脚本直接 exit 0、没有 git 时 REPO_ROOT 变空 ->
# 拼出 /tools/verify-launcher.ps1 -> 判定"文件不存在" -> 跳过检查。
# 这两种情况都会把"工具缺失"伪装成"检查通过"，比没有 hook 更危险。
command -v git  >/dev/null 2>&1 || { echo "[pre-commit] 找不到 git，拒绝在未检查的情况下放行" >&2; exit 1; }
command -v grep >/dev/null 2>&1 || { echo "[pre-commit] 找不到 grep，拒绝在未检查的情况下放行" >&2; exit 1; }

REPO_ROOT="$(git rev-parse --show-toplevel)"
CHECKER="$REPO_ROOT/tools/verify-launcher.ps1"

if [ ! -f "$CHECKER" ]; then
    echo "[pre-commit] 找不到 $CHECKER，跳过检查" >&2
    exit 0
fi

# 只有可变文件出现在本次提交里时才跑，避免每次提交都等一遍。
#
# 必须加 `-c core.quotepath=false`：git 默认会把非 ASCII 文件名输出成
# "\346\211\223..."（带引号、八进制转义），于是 `\.bat$` 永远匹配不上
# —— 中文名的启动脚本就会被静默跳过检查（实测过：弄坏 .bat 后提交照样成功）。
if git -c core.quotepath=false diff --cached --name-only | grep -Eq '\.(bat|cmd|ps1|gitattributes)$'; then
    echo "[pre-commit] 检查启动脚本维护规则..."
    if ! powershell -NoProfile -ExecutionPolicy Bypass -File "$CHECKER"; then
        echo ""
        echo "[pre-commit] 启动脚本规则未通过，已阻止提交。" >&2
        echo "             修好后重试，或临时用 git commit --no-verify 跳过。" >&2
        exit 1
    fi
fi

exit 0
